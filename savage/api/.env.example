# PostgreSQL (mesmo banco do core Minecraft)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=savagemc
PGUSER=savagemc
PGPASSWORD=

# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# CORS — use * para público ou liste origens separadas por vírgula
CORS_ORIGIN=*

# Rate limit (requisições por IP a cada 15 min)
RATE_LIMIT_MAX=10
